{
  "name": "exo",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code mod: guards against costly mistakes, a cockpit while working, a recap at the end and a few extras",
  "type": "module",
  "license": "MIT",
  "author": "Martin Pfeffer <martin.pfeffer@celox.io> (https://celox.io)",
  "repository": "github:pepperonas/exo",
  "scripts": {
    "test": "node --import tsx --test tests/*.spec.ts",
    "test:engine": "claude plugin test .",
    "typecheck": "tsc -p .",
    "validate": "claude plugin validate --strict .",
    "check": "tsc -p . && claude plugin validate --strict .",
    "mutate": "node --import tsx tools/mutate.ts",
    "history-scan": "node --import tsx tools/history-scan.ts",
    "social": "node --import tsx tools/social.ts",
    "screens": "node --import tsx tools/screens.ts"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
